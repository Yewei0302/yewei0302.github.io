{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[svelte]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "liveServer.settings.root": "/dist",
  "frontMatter.dashboard.openOnStart": false,
  "files.exclude": {
    ".npmrc": true,
    "tests": true,
    "pnpm-workspace.yaml": true,
    "_frontmatter.json": true,
    "THIRD_PARTY_NOTICES.md": true,
    "README*": true,
    ".astro": true,
    "biome.json": true,
    "node_modules": true,
    "scripts": true,
    ".git": true,
    ".github": true,
    "LICENSE*": true,
    "svelte.config.js": true,
    "vercel.json": true,
    "postcss.config.mjs": true,
    ".devin": true,
    "pagefind.yml": true,
    ".gitignore": true,
    "CLAUDE.md": true,
    "private-local-backup": true,
    ".wrangler": true,
    "dist-*": true,
    "docs": true,
    ".vscode": true,
    ".env.example": true,
    ".gitattributes": true,
    "tsconfig.json": true,
    "logo.png": true,
    "pnpm-lock.yaml": true,
    "dist": true
  },
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.compactFolders": false,
  "git.autofetch": false,
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/dist-*/**": true
  }
}
