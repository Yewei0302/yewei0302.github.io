 show(scene){const states={
 idle:{badge:'停机 · 等待指令',title:'QF 闭合，电机也可以不转。',detail:'没有运行指令，KM 线圈失电，主触点保持断开。先把“保护开关合上”和“电机启动”分开。',steps:['QF 已闭合','尚无运行指令','KM 主触点断开','电机停止']},
 run:{badge:'运行 · 主回路导通',title:'线圈得电，主触点才吸合。',detail:'运行指令建立，FR 常闭触点保持闭合，KM 线圈得电，主触点吸合，电机获得三相供电。',steps:['给出运行指令','FR 控制触点闭合','KM 得电并吸合','电机运行']},
 overload:{badge:'过载 · FR 已动作',title:'FR 断开控制回路，由 KM 切断主回路。',detail:'此处展示过载保护动作后的状态，不模拟延时。FR 热元件并未直接断开三相导线，打开的是控制触点。',steps:['持续过电流达到动作条件','FR 常闭触点断开','KM 线圈失电、主触点释放','电机失去供电并停止']},
 short:{badge:'短路 · QF 已跳开',title:'切除短路故障的是 QF。',detail:'本示意的控制电源独立，KM 线圈仍得电、主触点仍可能闭合，但 QF 已切断主回路供电。不要把 KM 的状态等同于主回路是否带电。',steps:['发生短路故障','QF 按保护特性跳开','三相主回路供电切断','电机停止；控制电源可仍在']}
 };const state=states[scene];if(!state)return;this.dataset.scene=scene;this.querySelectorAll('[data-scene-button]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.sceneButton===scene)));const set=(key,value)=>{this.querySelector('[data-'+key+']').textContent=value;};set('state-badge',state.badge);set('status-title',state.title);set('status-detail',state.detail);this.querySelectorAll('[data-step]').forEach((n,i)=>n.textContent=state.steps[i]);const coil=scene==='run'||scene==='short';set('qf-text',scene==='short'?'跳开 · 切除故障':'闭合');set('km-text',coil?'闭合 · 已吸合':'断开 · 已释放');set('fr-text',scene==='overload'?'检测到过载并动作':'检测三相电流');set('fr-contact-text',scene==='overload'?'已断开 · 95—96':'正常闭合 · 95—96');set('coil-text',coil?'得电':'失电');set('command-text',scene==='idle'?'未给出':'已给出');set('motor-text',scene==='run'?'运行':'停止');this.querySelector('[data-qf-contact]').setAttribute('d',scene==='short'?'M90 64V78M90 98L102 78M90 98V110 M120 64V78M120 98L132 78M120 98V110 M150 64V78M150 98L162 78M150 98V110':'M90 64V110 M120 64V110 M150 64V110');this.querySelector('[data-km-contact]').setAttribute('d',coil?'M90 152V200 M120 152V200 M150 152V200':'M90 152V166M90 186L102 166M90 186V200 M120 152V166M120 186L132 166M120 186V200 M150 152V166M150 186L162 166M150 186V200');this.querySelector('[data-fr-contact]').setAttribute('d',scene==='overload'?'M120 152V163 M120 189V200 M120 189L138 164 M108 174H132':'M120 152V163 M120 189V200 M120 163V189 M108 174H132');}
}
if(!customElements.get('a1-motor-demo'))customElements.define('a1-motor-demo',A1MotorDemo);

</script>
