class A1MotorDemo extends HTMLElement {
 connectedCallback(){if(this.dataset.ready)return;this.dataset.ready='true';this.addEventListener('click',this.onClick);this.show('idle');}
 disconnectedCallback(){this.removeEventListener('click',this.onClick);delete this.dataset.ready;}
