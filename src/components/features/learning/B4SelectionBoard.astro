<section class="b4-board" aria-label="导线与保护配合教学核查">
<p class="kicker">选型核查卡 · 只演示给定条件下的一项关系</p><h3>换一个截面，看看校核对象有没有变</h3>
<div class="modes" role="group" aria-label="算例"><button type="button" data-case="small" aria-pressed="true">7.5 kW · QF 20 A</button><button type="button" data-case="large" aria-pressed="false">15 kW · QF 40 A</button></div>
<div class="metrics"><div><span>题设负荷电流 IB</span><strong data-ib>15.79 A</strong></div><div><span>假设保护额定值 In</span><strong data-in>20 A</strong></div><div><span>修正后载流量 Iz</span><strong data-iz>23.49 A</strong></div></div>
<div class="wire-options" role="group" aria-label="导线候选"><button type="button" data-wire="first" aria-pressed="true">4 mm²</button><button type="button" data-wire="second" aria-pressed="false">2.5 mm²</button></div>
<div class="verdict" aria-live="polite"><b data-relation>15.79 ≤ 20 ≤ 23.49 A</b><p data-verdict>这一项满足；仍未完成启动、短路、环境及协调验证。</p></div><p class="calculation" data-calculation>题给基准27 A × 温度系数0.87＝23.49 A。</p><small>仅当所选基准表、修正条件及过载保护分工适用时，这项简化关系才有意义。不是自动设计或施工选型工具。</small>
</section>
<style>
.b4-board{padding:25px;border:1px solid #cdded4;border-radius:20px;background:linear-gradient(130deg,#edf6ef,#f2f4fb);color:#2b4738;margin:26px 0}.kicker{font-size:11px;letter-spacing:.08em;color:#5b7e68}.b4-board h3{font-size:24px;margin:10px 0 20px}.modes,.wire-options{display:flex;gap:9px;flex-wrap:wrap;margin:16px 0}.b4-board button{padding:9px 14px;border:1px solid #bfd0c5;border-radius:25px;background:#fff;color:#335740;cursor:pointer;font-size:13px}.b4-board button[aria-pressed=true]{background:#3f7658;color:#fff;border-color:#3f7658}.metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:20px 0}.metrics>div{padding:16px 13px;background:#fff;border-radius:12px}.metrics span{display:block;font-size:11px;color:#657e6e}.metrics strong{display:block;font-size:25px;color:#355f48;margin-top:9px}.verdict{border-radius:12px;padding:18px;background:#e0eee5}.verdict b{font-size:23px}.verdict p{font-size:13px;line-height:1.8;margin:7px 0 0}.b4-board[data-pass=false] .verdict{background:#fff0de;color:#80501b}.calculation{font-size:13px}.b4-board small{font-size:11px;display:block;line-height:1.8}:global(.dark) .b4-board{background:linear-gradient(130deg,#283c30,#2a3445);color:#e2ede5;border-color:#496453}:global(.dark) .metrics>div{background:#223329}:global(.dark) .metrics strong{color:#abd4b8}:global(.dark) .metrics span{color:#b5cabd}:global(.dark) .verdict{background:#355641}@media(max-width:600px){.b4-board{padding:18px 14px}.b4-board h3{font-size:20px}.metrics{grid-template-columns:1fr}.metrics>div{display:flex;justify-content:space-between;align-items:center}.metrics strong{margin:0;font-size:23px}.verdict b{font-size:20px}}
</style>
<script>
function initB4(){document.querySelectorAll<HTMLElement>('.b4-board').forEach(root=>{if(root.dataset.ready)return;root.dataset.ready='true';let active='small',wire='first';const data:Record<string,{ib:number,n:number,w:{label:string,base:number}[]}>={small:{ib:7500/(Math.sqrt(3)*380*.88*.82),n:20,w:[{label:'4 mm²',base:27},{label:'2.5 mm²',base:20}]},large:{ib:15000/(Math.sqrt(3)*380*.9*.85),n:40,w:[{label:'6 mm²',base:35},{label:'10 mm²',base:48}]}};function render(){const d=data[active],item=d.w[wire==='first'?0:1],iz=item.base*.87,ok=d.ib<=d.n&&d.n<=iz;const set=(sel:string,v:string)=>{const el=root.querySelector(sel);if(el)el.textContent=v};set('[data-ib]',`${d.ib.toFixed(2)} A`);set('[data-in]',`${d.n} A`);set('[data-iz]',`${iz.toFixed(2)} A`);set('[data-relation]',`${d.ib.toFixed(2)} ≤ ${d.n} ${d.n<=iz?'≤':'>'} ${iz.toFixed(2)} A`);set('[data-verdict]',ok?'这一项满足；仍未完成启动、短路、环境及协调验证。':'这一项不满足：在本题假设的保护分工下，不能凭Iz大于IB就确认导线合适。');set('[data-calculation]',`题给基准${item.base} A × 温度系数0.87＝${iz.toFixed(2)} A。`);root.dataset.pass=String(ok);root.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.case===active)));root.querySelectorAll<HTMLButtonElement>('[data-wire]').forEach((b,i)=>{b.textContent=d.w[i].label;b.setAttribute('aria-pressed',String(b.dataset.wire===wire))})}root.querySelectorAll<HTMLButtonElement>('[data-case]').forEach(b=>b.addEventListener('click',()=>{active=b.dataset.case||'small';wire='first';render()}));root.querySelectorAll<HTMLButtonElement>('[data-wire]').forEach(b=>b.addEventListener('click',()=>{wire=b.dataset.wire||'first';render()}));render()})}initB4();document.addEventListener('astro:page-load',initB4);document.addEventListener('swup:page:view',initB4);
</script>
