---
interface Props {
	items: {
		url: string;
		label: string;
		heading: string;
		detail: string;
		image: string;
		alt: string;
	}[];
}
const { items } = Astro.props;

import templatePictures from "../../../config/templatePictures.json";
---
<div class="project-showcase card-base" data-project-showcase role="region" aria-label="项目成果轮播">
 {items.map((item,index)=><a class="project-window" href={item.url} data-project-slide hidden={index!==0} aria-label={item.heading+'，打开项目'}><div class="window-header"><span class="window-dots" aria-hidden="true">● ● ●</span><span>{item.label}</span><span>打开项目 ↗</span></div><div class="demo-screen"><img src={item.image} alt={item.alt} loading="lazy"/></div><div class="project-caption homepage-photo-card"><img class="home-card-background" src={templatePictures[2]?.src} alt="" loading="lazy"/><span class="small-label">PLC练习项目</span><h2>{item.heading}</h2><p>{item.detail}</p></div></a>)}
 {items.length>1&&<div class="project-carousel-controls"><button type="button" data-carousel-prev aria-label="上一个项目">←</button><span data-carousel-count aria-live="off">1 / {items.length}</span><button type="button" data-carousel-next aria-label="下一个项目">→</button><button type="button" data-carousel-pause aria-pressed="false">暂停轮播</button></div>}
</div>
<script>import '../../../scripts/project-showcase.js';</script>
