.danger{background:#fdf0ee;border-left:3px solid #c0392b;border-radius:6px;
  padding:14px 16px;margin:16px 0}
.note b,.warn b,.danger b{color:#12483c}
.warn b{color:#8a5a12}
.danger b{color:#9c2a1f}

/* ---------- 公式 ---------- */
.fml{background:#f4f8f6;border:1px solid #e0eae5;border-left:3px solid #26775f;
  border-radius:7px;padding:14px 18px;margin:14px 0;
  font:14.5px/2 Consolas,'Cascadia Mono','Microsoft YaHei',monospace;overflow-x:auto;white-space:pre-wrap}
.fml .k{color:#8a5a12}
