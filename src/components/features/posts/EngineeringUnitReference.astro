/* ---------- 表格 ---------- */
.tw{overflow-x:auto;margin:14px 0}
table{border-collapse:collapse;width:100%;font-size:14.5px}
th,td{text-align:left;border-bottom:1px solid #e4ebee;padding:10px 12px;vertical-align:top}
th{background:#eef4f1;color:#1c4a41;font-weight:600;white-space:nowrap}
tbody tr:hover{background:#fafcfb}
td.mono{font-family:Consolas,'Cascadia Mono',monospace;font-size:13.5px;white-space:nowrap}
td.num{font-family:Consolas,monospace;font-size:13.5px;white-space:nowrap;color:#1c4a41}

/* ---------- 量纲链 ---------- */
.chain{display:flex;flex-wrap:wrap;align-items:stretch;gap:10px;margin:18px 0}
.cstep{flex:1 1 150px;border:1px solid #d5e3dd;background:#f7fbf9;border-radius:10px;
  padding:12px 14px;min-width:140px}
.cstep .tag{display:inline-block;font-size:11.5px;letter-spacing:.05em;color:#fff;
  background:#4b7f6f;border-radius:5px;padding:1px 7px;margin-bottom:6px}
