.cstep.l1 .tag{background:#3c6b91}
.cstep.l2 .tag{background:#8a5a12}
.cstep.l3 .tag{background:#6b46c1}
.carrow{align-self:center;color:#9fb3ab;font-size:20px;flex:0 0 auto}

/* ---------- 对照双列 ---------- */
.duo{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0}
.pane{border:1px solid #dde8e3;border-radius:10px;overflow:hidden}
.pane .ph{padding:9px 14px;font-size:14px;font-weight:600;color:#fff;background:#3c6b91}
.pane.rot .ph{background:#8a5a12}
.pane .pb{padding:4px 14px 12px}
.pane table{font-size:14px}
.pane th{background:transparent;font-size:12.5px;color:var(--muted);padding:8px 6px}
.pane td{border-bottom:1px dashed #e4ebee;padding:8px 6px}

/* ---------- 换算器 ---------- */
.convgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,270px),1fr));gap:16px;margin:18px 0}
.conv{border:1px solid #dde8e3;border-radius:12px;padding:16px 16px 12px;background:#fbfdfc}
.conv h4{margin:0 0 10px;font-size:15px;color:#1c4a41;display:flex;justify-content:space-between;align-items:baseline}
.conv h4 small{font-weight:400;color:var(--muted);font-size:12px}
.conv-in{display:flex;gap:8px}
.conv-in input{flex:1 1 55%;min-width:0}
.conv-in select{flex:0 0 40%}
input,select{font:inherit;font-size:14.5px;border:1px solid #bdcdd3;border-radius:7px;
  padding:8px 10px;background:#fff;color:var(--ink);width:100%}
input:focus,select:focus{outline:2px solid #b7d6c9;outline-offset:1px;border-color:#7fae9d}
.conv-out{margin-top:10px;font-size:13.5px}
.conv-out div{display:flex;justify-content:space-between;gap:10px;padding:3px 0;
  border-bottom:1px dotted #e2ebe6}
.conv-out div:last-child{border:0}
.conv-out .lab{color:#4d6a63}
.conv-out .val{font-family:Consolas,monospace;color:#12483c;white-space:nowrap}
.conv-out .val.hi{color:#a9741f;font-weight:600}
.conv .tip{font-size:12px;color:#8a9aa0;margin-top:8px;line-height:1.6}

/* ---------- 计算器 ---------- */
.calc{border:1px solid #d5e3dd;border-radius:12px;padding:18px;background:#f7fbf9;margin:16px 0}
.calc h4{margin:0 0 4px;font-size:16px;color:#123f35}
.calc .sub{font-size:13px;color:var(--muted);margin-bottom:14px}
.calc-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));gap:12px;margin-bottom:12px}
.calc-row label{display:block;font-size:13px;color:#4d6a63;margin-bottom:4px}
.btn{border:1px solid #9db9af;background:#fff;color:#176c58;border-radius:7px;
  padding:8px 14px;cursor:pointer;font-size:14px;margin:0 6px 6px 0}
.btn:hover{background:#eaf4ee}
.btn.primary{background:#1d5b4c;color:#fff;border-color:#1d5b4c}
.btn.primary:hover{background:#246b59}
.calc-res{margin-top:12px;background:#eef6f1;border-radius:8px;padding:12px 14px;
  font-size:14.5px;min-height:24px}
.calc-res b{color:#0f5a4a;font-family:Consolas,monospace}

/* ---------- 徽章 ---------- */
.badge{display:inline-block;font-size:12px;border-radius:5px;padding:1px 8px;
  border:1px solid;margin-right:6px;white-space:nowrap}
.b-e{color:#1f5fb0;border-color:#b9cfe8;background:#f0f6fd}
.b-m{color:#a9741f;border-color:#e6d3ac;background:#fdf7ec}
.b-f{color:#0f6f66;border-color:#b2dad4;background:#eff9f7}
.b-t{color:#b42318;border-color:#ecc4bf;background:#fdf2f0}
.b-k{color:#6b46c1;border-color:#d3c8ec;background:#f6f3fd}

/* ---------- 搜索 ---------- */
.searchbox{display:flex;gap:10px;align-items:center;margin:16px 0}
.searchbox input{max-width:420px}
.searchbox .cnt{font-size:13px;color:var(--muted);white-space:nowrap}

/* ---------- 步骤 ---------- */
.steps{counter-reset:s;list-style:none;padding:0;margin:16px 0}
.steps li{position:relative;padding:12px 0 12px 46px;border-bottom:1px dashed #e0eae5}
.steps li:last-child{border:0}
.steps li::before{counter-increment:s;content:counter(s);position:absolute;left:0;top:12px;
  width:30px;height:30px;border-radius:50%;background:#1d5b4c;color:#fff;
  display:grid;place-items:center;font-size:14px;font-weight:600}
.steps b{color:#123f35}



@media(max-width:760px){
  .duo{grid-template-columns:1fr}
  section{padding:20px 17px}

  .convgrid{grid-template-columns:1fr}
}
@media print{
  nav.toc,.btn{display:none}
  :scope{background:#fff}
  section{break-inside:avoid;box-shadow:none}
}
:scope{display:block;padding:clamp(8px,2vw,18px);border-radius:12px;overflow-wrap:anywhere}
section{scroll-margin-top:7rem;min-width:0}
.conv,.calc-row > div,.pane,.conv-in select{min-width:0}
.conv h4,.searchbox{flex-wrap:wrap}
.conv-out .val{white-space:normal;text-align:right}
.pane .pb{overflow-x:auto}
.tw table{min-width:30rem}

}
