---
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";
import { getSortedPostsList } from "../../../utils/content-utils";
import { blogSections, matchesSection } from "../../../config/blogSections";
import ButtonLink from "../../control/ButtonLink.astro";
import WidgetLayout from "../common/WidgetLayout.astro";

const posts = await getSortedPostsList();
const categories = blogSections.map((section) => ({
    name: section.name,
    url: `/topics/${section.slug}/`,
    count: posts.filter((post) => matchesSection(post, section.slug)).length,
}));

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout
	name={i18n(I18nKey.categories)}
	id="categories"
	isCollapsed={false}
	class={className}
	style={style}
>
	{
		categories.map((c) => (
			<ButtonLink
				url={c.url}
				badge={String(c.count)}
				label={`查看${c.name}，${c.count}篇文章`}
			>
				{c.name.trim()}
			</ButtonLink>
		))
	}
</WidgetLayout>
