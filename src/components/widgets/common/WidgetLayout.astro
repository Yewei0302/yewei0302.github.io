---
import { Icon } from "astro-icon/components";
import templatePictures from "../../../config/templatePictures.json";
import "../../../styles/widget-pictures.css";

import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";

interface Props {
	id: string;
	name?: string;
	isCollapsed?: boolean;
	collapsedHeight?: string;
	class?: string;
	style?: string;
}
const { id, name, isCollapsed, collapsedHeight, style } = Astro.props;
const className = Astro.props.class;
const isHome = Astro.url.pathname === "/";
---

<widget-layout
	data-id={id}
	data-is-collapsed={String(isCollapsed)}
	data-widget-pictures={isHome ? JSON.stringify(templatePictures) : undefined}
	class={"pb-4 card-base " + (isHome ? "widget-picture " : "") + className}
	style={style}
>
	{isHome&&templatePictures.length>0&&<img class="widget-background-photo" src={templatePictures[0].src} alt="" loading="lazy"/>}

	{
		name && (
			<div
				class="font-bold transition text-lg text-neutral-900 dark:text-neutral-100 relative ml-8 mt-4 mb-2 flex items-center
        before:w-1 before:h-4 before:rounded-md before:bg-(--primary)
        before:absolute before:-left-4 before:top-[5.5px]"
			>
				{name}
				<slot name="title-icon" />
			</div>
		)
	}
	<div
		data-widget-content={id}
		class:list={[
			"collapse-wrapper px-4 overflow-hidden",
			{ collapsed: isCollapsed },
		]}
	>
		<slot />
	</div>
	{
		isCollapsed && (
			<div class="expand-btn px-4 -mb-2">
				<button class="btn-plain rounded-lg w-full h-9">
					<div class="text-(--primary) flex items-center justify-center gap-2 -translate-x-2">
						<Icon
							name="material-symbols:more-horiz"
							class="text-[1.75rem]"
						/>{" "}
						{i18n(I18nKey.more)}
					</div>
				</button>
			</div>
		)
	}
</widget-layout>

<style define:vars={{ collapsedHeight }}>
	.collapsed {
		height: var(--collapsedHeight);
	}
</style>

<script>
	class WidgetLayout extends HTMLElement {
		constructor() {
			super();

			if (this.dataset.isCollapsed !== "true") {
				return;
			}


			const btn = this.querySelector(".expand-btn");
			const wrapper = this.querySelector(".collapse-wrapper");
			btn!.addEventListener("click", () => {
				wrapper!.classList.remove("collapsed");
				btn!.classList.add("hidden");
			});
		}
	}

	if (!customElements.get("widget-layout")) {
		customElements.define("widget-layout", WidgetLayout);
	}
</script>

<script>import '../../../scripts/widget-pictures.js';</script>
